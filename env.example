OPENAI_API_KEY=sk-your-project-key
PUBLIC_BASE_URL=https://your-service.example.com
TWILIO_ACCOUNT_SID=AC-your-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
RECORD_CALLS=false
RECORDING_NOTICE=This call may be recorded for quality and training. By continuing, you consent to the recording.
OPENAI_VOICE=marin
BACKEND_MODEL=gpt-6-luna
BACKEND_REASONING_EFFORT=medium
OPENING_GREETING_INSTRUCTIONS=Greet the person now in English. Introduce yourself as the assistant and ask how you can help. Then pause and listen.
LIVE_INSTRUCTIONS=You are a friendly telephone assistant. Speak naturally and concisely. Ask one question at a time.
BACKEND_INSTRUCTIONS=Answer accurately and briefly. Never claim an external action succeeded unless it is confirmed.
